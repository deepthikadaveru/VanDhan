# PostgreSQL connection string used by Prisma.
# Local example:   postgresql://postgres:postgres@localhost:5432/vandhan?schema=public
# Supabase/Neon/Railway: paste the connection string they give you.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vandhan?schema=public"

# Secret used to sign session JWTs. Generate your own for real deployments, e.g.:
#   openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"

NODE_ENV="development"
